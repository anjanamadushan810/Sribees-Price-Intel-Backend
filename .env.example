# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://intel:CHANGE_ME@postgres:5432/intel
POSTGRES_PASSWORD=CHANGE_ME
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=CHANGE_ME
TWO_FACTOR=true
CORS_ORIGINS=[]

# SRIBEESonline admin API, through a dedicated super-admin account made for this
# service (never a person's login). Dev: the internal container address.
ONLINE_API_URL=http://sribees-online-dev-app:8000
ONLINE_ADMIN_EMAIL=price-intel@sribeesonline.com
ONLINE_ADMIN_PASSWORD=CHANGE_ME

SCRAPE_DELAY_SECONDS=2
